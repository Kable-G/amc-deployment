# AutoMediaCenter - Environment Variable Template
# Copy to .env and fill in real values from your password manager.
# NEVER commit the real .env file to git.

# --- Core ---
NODE_ENV=production
PORT=5000

# --- Database ---
MONGO_URI=

# --- Auth / Security ---
JWT_SECRET=
SESSION_SECRET=

# --- URLs ---
# KNOWN QUIRK: the app reads from all six of these. During the HTTPS
# migration, only some of these were updated at first, which caused bugs.
# All six should point at the production domain until the codebase
# is consolidated to use just one canonical variable.
APP_BASE_URL=
APP_URL=
BASE_URL=
FRONTEND_URL=
SITE_URL=
OAUTH_CALLBACK_BASE_URL=

# --- Email (Brevo SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Third-party APIs ---
ANTHROPIC_API_KEY=

# --- Alerts ---
ALERT_ENABLED=true
ALERT_DRY_RUN=false
