</head>
<body>
<!-- Welcome Modal (Hidden by default) -->
<div id="welcomeModal" class="simple-welcome-backdrop hidden">
    <div class="simple-welcome-modal">
        <button class="welcome-close-btn" onclick="hideWelcomeModal()" title="Close Welcome Modal">
            <i class="fas fa-times"></i>
        </button>
        
        <div class="welcome-header">
            <h2 id="welcomeGreeting">Welcome back!</h2>
            <p class="welcome-subtitle">You're signed in and ready to explore.</p>
        </div>
        
        <div class="welcome-content">
            <div class="release-update">
                <div class="release-icon">
                    <i class="fas fa-newspaper"></i>
                </div>
                <div class="release-text">
                    <p>Since your last visit, <strong>42 new media releases</strong> have been added - dive in and discover what's new.</p>
                </div>
            </div>
        </div>
        
        <div class="welcome-footer">
            <button class="btn-continue" id="closeWelcomeBtn" onclick="hideWelcomeModal()">
                Continue
                <i class="fas fa-arrow-right"></i>
            </button>
        </div>
        
        <!-- Role-based color dot -->
        <div class="role-indicator" id="roleIndicator"></div>
    </div>
</div>

<!-- Page Content Filter (Hidden by default) -->
<div id="pageFilter" class="page-content-filter hidden"></div>

<!-- Toast Notification Container -->
<div class="toast-container" id="toastContainer"></div>

