<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AutoMediaCenter Mobile</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* ===== CSS VARIABLES - EXACT DESKTOP MATCH ===== */
        :root {
            --bg-primary: #f3f4f6;
            --bg-secondary: #ffffff;
            --bg-tertiary: #f9fafb;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-headings: #0f172a;
            --border-primary: #e2e8f0;
            --border-card: #d1d5db;
            --accent-primary: #3b82f6;
            --color-danger: #ef4444;
            --card-hover-shadow: 0 4px 12px rgba(0,0,0,0.1);
        }
        
        body.dark-mode {
            --bg-primary: #0f1419;
            --bg-secondary: #1a1f2e;
            --bg-tertiary: #161b26;
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --text-headings: #f1f5f9;
            --border-primary: #2d3748;
            --border-card: #374151;
            --card-hover-shadow: 0 4px 20px rgba(59,130,246,0.3);
        }
        
        /* ===== BASE RESET ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html, body {
            width: 100%;
            height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            font-size: 16px;
            color: var(--text-primary);
            background: var(--bg-primary);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
            transition: background 0.3s ease, color 0.3s ease;
        }
        
        /* ===== MOBILE HEADER - CLEANER DESIGN ===== */
        .mobile-header {
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            height: 56px;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            z-index: 1000;
        }
        
        .header-left {
            display: flex;
            align-items: center;
            width: 60px;
        }
        
        .header-center {
            flex: 1;
            display: flex;
            justify-content: center;
        }
        
        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 60px;
            justify-content: flex-end;
        }
        
        .mobile-hamburger {
            width: 40px;
            height: 40px;
            background: none;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-primary);
            font-size: 18px;
            border-radius: 6px;
        }
        
        .mobile-hamburger:active {
            background: var(--bg-tertiary);
        }
        
        /* BIGGER LOGO - DESKTOP MATCH - NOW AS BUTTON */
        .mobile-logo {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.02em;
            font-family: 'Inter', -apple-system, sans-serif;
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease;
            background: none;
            border: none;
            padding: 0;
            margin: 0;
        }
        
        .mobile-logo:active {
            color: var(--accent-primary);
            transform: scale(0.96);
        }
        
        .header-icon-btn {
            width: 40px;
            height: 40px;
            background: none;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-primary);
            font-size: 18px;
            position: relative;
            border-radius: 6px;
        }
        
        .header-icon-btn:active {
            background: var(--bg-tertiary);
        }
        
        .header-icon-btn .badge {
            position: absolute;
            top: 6px;
            right: 6px;
            background: var(--color-danger);
            color: #fff;
            font-size: 9px;
            font-weight: 700;
            padding: 2px 4px;
            border-radius: 8px;
            min-width: 14px;
            text-align: center;
            line-height: 1;
        }
        
        /* ===== SIMPLIFIED AVATAR - SOLID COLOR, NO RING ===== */
        .amc-avatar {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s ease;
            border-radius: 50%;
        }
        
        .amc-avatar:active {
            transform: scale(0.95);
        }
        
        .amc-avatar i {
            font-size: 24px;
        }
        
        /* Role-based colors - SOLID AVATAR */
        .amc-avatar.role-media-user {
            color: #3B82F6; /* Blue */
        }
        
        .amc-avatar.role-client-user {
            color: #10B981; /* Green */
        }
        
        .amc-avatar.role-client-admin {
            color: #F59E0B; /* Yellow */
        }
        
        .amc-avatar.role-platform-admin {
            color: #EF4444; /* Red */
        }
        
        /* Dark mode avatar colors - brighter */
        body.dark-mode .amc-avatar.role-media-user {
            color: #60a5fa;
        }
        
        body.dark-mode .amc-avatar.role-client-user {
            color: #34d399;
        }
        
        body.dark-mode .amc-avatar.role-client-admin {
            color: #fbbf24;
        }
        
        body.dark-mode .amc-avatar.role-platform-admin {
            color: #f87171;
        }
        
        /* ===== AVATAR MODAL AS LAUNCHER ===== */
        .avatar-modal {
            position: fixed;
            top: 60px;
            right: 10px;
            width: 280px;
            background: var(--bg-secondary);
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.12);
            border-radius: 12px;
            z-index: 2000;
            transition: all 0.3s ease;
            border: 1px solid var(--border-primary);
            overflow: hidden;
            transform: translateY(-10px);
            opacity: 0;
        }
        
        .avatar-modal:not(.hidden) {
            transform: translateY(0);
            opacity: 1;
        }
        
        .avatar-modal.hidden {
            display: none;
        }
        
        .avatar-modal-header {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid var(--border-primary);
            background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
        }
        
        .avatar-modal-avatar {
            display: grid;
            place-items: center;
            margin-bottom: 12px;
        }
        
        .avatar-modal-avatar i {
            font-size: 48px;
        }
        
        .avatar-email {
            font-weight: 600;
            font-size: 1em;
            color: var(--text-headings);
            margin-bottom: 4px;
        }
        
        .avatar-role {
            font-size: 0.85em;
            color: var(--text-secondary);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        /* Quick Access Icons Section */
        .modal-quick-access {
            padding: 16px;
            border-bottom: 1px solid var(--border-primary);
            display: flex;
            gap: 12px;
            justify-content: center;
        }
        
        .quick-access-btn {
            flex: 1;
            padding: 16px 12px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border-primary);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            position: relative;
        }
        
        .quick-access-btn:active {
            transform: scale(0.95);
            background: var(--bg-primary);
        }
        
        .quick-access-btn i {
            font-size: 20px;
            color: var(--accent-primary);
        }
        
        .quick-access-btn span {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .quick-access-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--color-danger);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
            min-width: 18px;
            text-align: center;
        }
        
        /* Profile Actions Section */
        .avatar-modal-section {
            padding: 8px 0;
        }
        
        .modal-btn {
            width: 100%;
            padding: 12px 20px;
            border: none;
            background: none;
            text-align: left;
            font-size: 0.95em;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-primary);
            transition: all 0.2s ease;
            font-weight: 500;
        }
        
        .modal-btn:active {
            background: var(--bg-tertiary);
        }
        
        .modal-btn i {
            width: 16px;
            text-align: center;
            opacity: 0.7;
        }
        
        .modal-divider {
            margin: 8px 20px;
            border: none;
            border-top: 1px solid var(--border-primary);
        }
        
        .modal-btn-danger {
            color: var(--color-danger);
        }
        
        .modal-btn-danger:active {
            background: rgba(239, 68, 68, 0.1);
        }
        
        .theme-toggle-text {
            flex: 1;
        }
        
        .theme-toggle-indicator {
            font-size: 16px;
        }
        
        /* ===== CART MODAL - SLIDES IN FROM RIGHT ===== */
        .cart-modal {
            position: fixed;
            top: 56px;
            right: -100%;
            width: 100%;
            max-width: 400px;
            height: calc(100vh - 56px);
            background: var(--bg-secondary);
            box-shadow: -4px 0 20px rgba(0,0,0,0.15);
            z-index: 2002;
            transition: right 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        
        .cart-modal.active {
            right: 0;
        }
        
        .cart-modal-header {
            padding: 20px;
            border-bottom: 1px solid var(--border-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }
        
        .cart-modal-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-headings);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .cart-modal-close {
            width: 32px;
            height: 32px;
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 20px;
            cursor: pointer;
            border-radius: 6px;
        }
        
        .cart-modal-close:active {
            background: var(--bg-tertiary);
        }
        
        .cart-modal-content {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }
        
        .cart-item {
            padding: 12px 0;
            border-bottom: 1px solid var(--border-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        
        .cart-item:last-child {
            border-bottom: none;
        }
        
        .cart-item-info {
            flex: 1;
            min-width: 0;
        }
        
        .cart-item-title {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .cart-item-brand {
            font-size: 12px;
            color: var(--text-secondary);
        }
        
        .cart-item-remove {
            background: none;
            border: none;
            color: var(--color-danger);
            cursor: pointer;
            padding: 8px;
            font-size: 16px;
            border-radius: 6px;
        }
        
        .cart-item-remove:active {
            background: rgba(239, 68, 68, 0.1);
        }
        
        .cart-empty {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-secondary);
        }
        
        .cart-empty i {
            font-size: 48px;
            margin-bottom: 12px;
            opacity: 0.3;
        }
        
        .cart-modal-footer {
            padding: 20px;
            border-top: 1px solid var(--border-primary);
            flex-shrink: 0;
        }
        
        .cart-checkout-btn {
            width: 100%;
            padding: 14px;
            background: var(--accent-primary);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .cart-checkout-btn:active {
            background: #2563eb;
        }
        
        /* ===== TOOLS DROPDOWN ===== */
        .tools-dropdown {
            position: fixed;
            top: 60px;
            right: 10px;
            width: 280px;
            background: var(--bg-secondary);
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.12);
            border-radius: 12px;
            z-index: 2001;
            transition: all 0.3s ease;
            border: 1px solid var(--border-primary);
            overflow: hidden;
            transform: translateY(-10px);
            opacity: 0;
        }
        
        .tools-dropdown:not(.hidden) {
            transform: translateY(0);
            opacity: 1;
        }
        
        .tools-dropdown.hidden {
            display: none;
        }
        
        .tools-dropdown-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .tools-dropdown-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-headings);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .tools-dropdown-close {
            width: 28px;
            height: 28px;
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 18px;
            cursor: pointer;
            border-radius: 4px;
        }
        
        .tools-dropdown-close:active {
            background: var(--bg-tertiary);
        }
        
        .tools-dropdown-content {
            padding: 8px;
        }
        
        .tool-item {
            padding: 12px 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .tool-item:active {
            background: var(--bg-tertiary);
        }
        
        .tool-item i {
            width: 20px;
            text-align: center;
            color: var(--accent-primary);
            font-size: 16px;
        }
        
        .tool-item span {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
        }
        
        /* ===== DESKTOP-STYLE DRAWER ===== */
        .mobile-drawer {
            position: fixed;
            top: 56px;
            left: -100%;
            width: 280px;
            height: calc(100vh - 56px);
            background: var(--bg-secondary);
            border-right: 1px solid var(--border-primary);
            z-index: 2001;
            transition: left 0.3s ease;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }
        
        .mobile-drawer.open {
            left: 0;
        }
        
        .drawer-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border-primary);
            flex-shrink: 0;
            background: var(--bg-tertiary);
        }
        
        .drawer-title {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
        }
        
        .drawer-close {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 32px;
            height: 32px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border-primary);
            border-radius: 6px;
            color: var(--text-secondary);
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }
        
        .drawer-close:active {
            background: var(--bg-primary);
        }
        
        .drawer-content {
            flex: 1;
            overflow-y: auto;
            padding: 56px 0 16px 0;
        }
        
        .drawer-section {
            padding: 20px 0 8px 0;
        }
        
        .drawer-section-header {
            padding: 6px 20px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-secondary);
            background: var(--bg-tertiary);
            margin: 0 12px 4px 12px;
            border-radius: 4px;
            padding-left: 10px;
        }
        
        /* Section-specific colors - work in both themes */
        .drawer-section:nth-child(1) .drawer-section-header {
            border-left: 3px solid #1d4ed8;
            background: linear-gradient(90deg, rgba(29, 78, 216, 0.1) 0%, var(--bg-tertiary) 100%);
        }
        
        .drawer-section:nth-child(2) .drawer-section-header {
            border-left: 3px solid #047857;
            background: linear-gradient(90deg, rgba(4, 120, 87, 0.1) 0%, var(--bg-tertiary) 100%);
        }
        
        .drawer-section:nth-child(3) .drawer-section-header {
            border-left: 3px solid #c2410c;
            background: linear-gradient(90deg, rgba(194, 65, 12, 0.1) 0%, var(--bg-tertiary) 100%);
        }
        
        .drawer-section:nth-child(4) .drawer-section-header {
            border-left: 3px solid #b91c1c;
            background: linear-gradient(90deg, rgba(185, 28, 28, 0.1) 0%, var(--bg-tertiary) 100%);
        }
        
        .drawer-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 20px;
            color: var(--text-primary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        
        .drawer-nav-item:active {
            background: var(--bg-tertiary);
        }
        
        .drawer-nav-item.active {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            border-left-color: #3b82f6;
        }
        
        .drawer-nav-item i {
            width: 18px;
            text-align: center;
            font-size: 16px;
            opacity: 0.7;
            color: var(--text-secondary);
        }
        
        .drawer-nav-item.active i {
            opacity: 1;
            color: #3b82f6;
        }
        
        /* ===== DRAWER BACKDROP ===== */
        .drawer-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 2000;
            display: none;
        }
        
        .drawer-backdrop.visible {
            display: block;
        }
        
        /* ===== FILTER PANEL ===== */
        .filter-panel {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: var(--bg-secondary);
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
            z-index: 1999;
            transition: transform 0.3s ease;
            transform: translateY(100%);
            max-height: 70vh;
            display: flex;
            flex-direction: column;
        }
        
        .filter-panel.active {
            transform: translateY(0);
        }
        
        .filter-panel-header {
            padding: 20px;
            border-bottom: 1px solid var(--border-primary);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }
        
        .filter-panel-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-headings);
        }
        
        .filter-panel-close {
            width: 32px;
            height: 32px;
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 20px;
            cursor: pointer;
            border-radius: 6px;
        }
        
        .filter-panel-close:active {
            background: var(--bg-tertiary);
        }
        
        .filter-panel-content {
            padding: 20px;
            overflow-y: auto;
            flex: 1;
        }
        
        .filter-section {
            margin-bottom: 24px;
        }
        
        .filter-section-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-headings);
            margin-bottom: 12px;
        }
        
        .filter-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .filter-chip {
            padding: 8px 16px;
            border: 1px solid var(--border-card);
            border-radius: 20px;
            background: var(--bg-secondary);
            color: var(--text-primary);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .filter-chip.active {
            background: var(--accent-primary);
            color: #fff;
            border-color: var(--accent-primary);
        }
        
        .filter-chip:active {
            transform: scale(0.95);
        }
        
        /* ===== MAIN CONTENT ===== */
        .mobile-main {
            padding: 16px 12px;
            min-height: calc(100vh - 56px);
        }
        
        .page-header {
            margin-bottom: 16px;
        }
        
        .page-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-headings);
            margin-bottom: 4px;
        }
        
        .page-header p {
            font-size: 14px;
            color: var(--text-secondary);
            font-weight: 400;
            line-height: 1.3;
            opacity: 0.8;
        }
        
        /* ===== SEARCH BAR ===== */
        .search-bar {
            margin-bottom: 16px;
        }
        
        .search-input-wrapper {
            display: flex;
            gap: 8px;
            position: relative;
        }
        
        .search-input {
            flex: 1;
            height: 44px;
            padding: 0 16px;
            border: 2px solid var(--border-primary);
            border-radius: 8px;
            font-size: 16px;
            background: var(--bg-secondary);
            color: var(--text-primary);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        
        .search-input:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        
        .search-input.searching {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
        }
        
        .search-btn {
            width: 44px;
            height: 44px;
            background: var(--accent-primary);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .search-btn:active {
            background: #2563eb;
        }
        
        /* ===== LOADING STATE ===== */
        .loading-container {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-secondary);
        }
        
        .loading-spinner {
            font-size: 32px;
            color: var(--accent-primary);
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        /* ===== CARD GRID ===== */
        .card-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            padding: 0 12px;
            box-sizing: border-box;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== MEDIA CARD ===== */
        .media-card {
            background: var(--bg-secondary);
            border-radius: 12px;
            overflow: hidden;
