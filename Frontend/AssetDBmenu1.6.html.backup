    <script>
    <script>
    // SECURITY: Initial authentication check - less aggressive approach
    (function() {
        console.log("SECURITY: Initial page access control initiated");
        
        // Don't hide the page immediately - let the proper auth check handle it
        window.authenticationVerified = false;
        
        // Quick check for basic authentication data
        const token = localStorage.getItem('token') || localStorage.getItem('authToken');
        const userString = localStorage.getItem('user') || localStorage.getItem('currentUser');
        
        if (!token || !userString) {
            console.log("SECURITY: No authentication data found - will show login");
            // Don't block immediately, let the main auth check handle it
            return;
        }
        
        let user;
        try {
            user = JSON.parse(userString);
        } catch (e) {
            console.log("SECURITY: Invalid user data - will show login");
            // Clear corrupted data
            localStorage.removeItem('user');
            localStorage.removeItem('currentUser');
            return;
        }
        
        // Basic role check - but don't block aggressively
        const userRole = user.role;
        console.log("SECURITY: Pre-check - User role:", userRole);
        
        // Only block if clearly a media_user (Level 1)
        if (userRole === 'media_user') {
            console.log("SECURITY: Media user detected - will be redirected by main auth check");
        }
        
        // Allow page to load and let the proper authentication system handle validation
        console.log("SECURITY: Pre-check completed - allowing main auth system to validate");
        window.authenticationVerified = true;
    })();
    </script>
