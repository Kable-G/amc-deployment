<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoMediaCenter - Upload Hub (v8 + Tracking)</title>
    <!-- Font Awesome, Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        :root { /* Color variables */
            --bg-primary: #f8f9fa; --bg-secondary: #ffffff; --bg-tertiary: #e9ecef; --text-primary: #212529; --text-secondary: #6c757d; --text-headings: #343a40; --accent-primary: #0d6efd; --accent-primary-hover: #0b5ed7; --accent-secondary: #6c757d; --accent-secondary-hover: #5c636a; --border-primary: #dee2e6; --border-secondary: #e0e0e0; --header-bg: #1e2327; --header-text: #ffffff; --header-link: #adb5bd; --icon-available: var(--accent-primary); --icon-unavailable: #ced4da; --shadow-primary: rgba(0, 0, 0, 0.08); --shadow-hover: rgba(0, 0, 0, 0.12); --overlay-bg: rgba(255, 255, 255, 0.9); --tag-bg: var(--bg-tertiary); --tag-text: var(--text-secondary);
            --color-success: #28a745; --color-warning: #ffc107; --color-danger: #dc3545; --bg-image-placeholder: #e9ecef; --brand-label-bg: rgba(0, 0, 0, 0.6); --font-family-main: 'Poppins', sans-serif; --sidebar-width: 240px; --header-height: 61px; --footer-height: 60px; --border-color-light: #e9ecef; --card-active-border-color: var(--accent-primary); --card-active-border-color-hover: var(--accent-primary-hover);
            --sidebar-active-border-width: 3px; --modal-backdrop-bg: rgba(0, 0, 0, 0.6); --modal-bg: var(--bg-secondary); --modal-border-color: var(--border-secondary); --modal-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            --login-overlay-bg: rgba(0,0,0,0.7);
            /* Radar Card Specific Colors for preview consistency */
            --radar-color-info: #17a2b8;
            --radar-color-warning: #ffc107;
            --radar-text-secondary: #6c757d;
            --radar-accent-primary: #0d6efd;
            /* AMC Card Preview styles */
            --amc-card-preview-brand-band-light-bg: #212529; 
            --amc-card-preview-brand-band-light-text: #f8f9fa;
            --amc-card-preview-icon-available: var(--accent-primary);
            --amc-card-preview-icon-unavailable: #ced4da;
            /* Table styles */
            --table-bg: var(--bg-secondary);
            --table-border-color: var(--border-primary);
            --table-header-bg: var(--bg-tertiary);
            --table-hover-bg: var(--bg-tertiary);
            --table-stripe-bg: #f2f2f2;
        }
        body.dark-mode { /* Dark mode variables */
             --bg-primary: #1a1a1a; --bg-secondary: #2c2c2c; --bg-tertiary: #3a3a3a; --text-primary: #e0e0e0; --text-secondary: #adb5bd; --text-headings: #f8f9fa; --accent-primary: #3f91ff; --accent-primary-hover: #5fa0ff; --accent-secondary: #7a8691; --accent-secondary-hover: #909ca7; --border-primary: #444; --border-secondary: #555; --header-bg: #111; --header-text: #f0f0f0; --header-link: #999; --icon-available: var(--accent-primary); --icon-unavailable: #555; --shadow-primary: rgba(0, 0, 0, 0.2); --shadow-hover: rgba(0, 0, 0, 0.3); --overlay-bg: rgba(44, 44, 44, 0.9); --tag-bg: #4a4a4a; --tag-text: var(--text-primary);
             --brand-label-bg: rgba(255, 255, 255, 0.15); --bg-image-placeholder: #3a3a3a; --card-active-border-color: var(--accent-primary); --card-active-border-color-hover: var(--accent-primary-hover);
             --modal-backdrop-bg: rgba(0, 0, 0, 0.8); --modal-bg: var(--bg-secondary); --modal-border-color: var(--border-primary); --modal-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
             --login-overlay-bg: rgba(0,0,0,0.85);
             --radar-color-info: #36c4d9;
             --radar-color-warning: #ffd04a;
             --radar-text-secondary: #adb5bd;
             --radar-accent-primary: #3f91ff;
            /* AMC Card Preview dark styles */
            --amc-card-preview-brand-band-dark-bg: #f8f9fa; 
            --amc-card-preview-brand-band-dark-text: #212529;
            --amc-card-preview-icon-available: var(--accent-primary);
            --amc-card-preview-icon-unavailable: #555;
            /* Table styles dark */
            --table-bg: var(--bg-secondary);
            --table-border-color: var(--border-primary);
            --table-header-bg: var(--bg-tertiary);
            --table-hover-bg: #3e3e3e; /* Darker hover */
            --table-stripe-bg: #333333; /* Darker stripe */
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; } body { font-family: var(--font-family-main); background-color: var(--bg-primary); color: var(--text-primary); line-height: 1.6; display: flex; flex-direction: column; min-height: 100vh; transition: background-color 0.3s ease, color 0.3s ease; } a { color: var(--accent-primary); text-decoration: none; } a:hover { color: var(--accent-primary-hover); text-decoration: underline; } .app-container { display: flex; flex-direction: column; flex-grow: 1; transition: opacity 0.3s ease; } .app-body { display: flex; flex-grow: 1; transition: margin-left 0.3s ease; } .app-header { background-color: var(--header-bg); color: var(--header-text); padding: 10px 25px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-primary); position: sticky; top: 0; z-index: 1020; height: var(--header-height); } .app-header .logo h1 { font-size: 1.5em; font-weight: bold; margin: 0; color: var(--header-text); } .app-header .user-info { font-size: 0.9em; } .app-header .user-info span { margin-right: 15px; opacity: 0.8; } .app-header .logout-link { color: var(--header-link); text-decoration: none; } .app-header .logout-link:hover { color: var(--header-text); text-decoration: none; } .app-header .logout-link i { margin-right: 5px; }
        .sidebar { width: var(--sidebar-width); background-color: var(--bg-secondary); border-right: 1px solid var(--border-secondary); display: flex; flex-direction: column; padding-top: 15px; flex-shrink: 0; transition: width 0.3s ease; position: sticky; top: var(--header-height); height: calc(100vh - var(--header-height)); overflow-y: auto; z-index: 1010; } .sidebar.collapsed { width: 70px; } .sidebar.collapsed .section-title, .sidebar.collapsed li a span, .sidebar.collapsed .sidebar-footer span, .sidebar.collapsed .toggle-text { opacity: 0; visibility: hidden; white-space: nowrap; width: 0; transition: opacity 0.1s linear, width 0.1s linear;} .sidebar.collapsed li a { justify-content: center; padding: 10px 0; border-left: var(--sidebar-active-border-width) solid transparent; } .sidebar.collapsed li a span { display: none; } .sidebar.collapsed li a i.fa-fw { margin-right: 0; font-size: 1.2em; } .sidebar.collapsed .sidebar-header { justify-content: center; } .sidebar-header { display: flex; justify-content: flex-end; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-secondary); margin-bottom: 15px; } #sidebar-toggle { background: none; border: none; color: var(--text-secondary); font-size: 1.2em; cursor: pointer; padding: 5px; } #sidebar-toggle:hover { color: var(--text-primary); } .sidebar nav { flex-grow: 1; } .sidebar-section { margin-bottom: 20px; padding: 0 10px; transition: padding 0.3s ease; } .sidebar.collapsed .sidebar-section { padding: 0 5px; } .sidebar .section-title { font-size: 0.7em; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; display: block; margin-bottom: 8px; padding: 0 10px; transition: opacity 0.2s ease; } .sidebar ul { list-style: none; }
        .sidebar li a { position: relative; display: flex; align-items: center; padding: 10px 15px; color: var(--text-primary); border-radius: 0 5px 5px 0; margin-bottom: 3px; font-size: 0.95em; font-weight: 500; text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease, border-left-color 0.2s ease; white-space: nowrap; overflow: hidden; border-left: var(--sidebar-active-border-width) solid transparent; } .sidebar li a i.fa-fw { width: 1.5em; margin-right: 10px; text-align: center; color: var(--text-secondary); opacity: 0.8; flex-shrink: 0; transition: margin-right 0.3s ease, font-size 0.3s ease; } .sidebar li a span { transition: opacity 0.2s ease; display: inline-block; vertical-align: middle; } .sidebar li a:hover { background-color: var(--bg-tertiary); color: var(--text-headings); text-decoration: none; border-left-color: var(--accent-secondary); } .sidebar li.active a { background-color: var(--bg-tertiary); color: var(--accent-primary); font-weight: 600; border-left-color: var(--accent-primary); } .sidebar li.active a:hover { background-color: var(--bg-tertiary); border-left-color: var(--accent-primary-hover); color: var(--accent-primary-hover); } .sidebar li.active a i { opacity: 1; color: var(--accent-primary); } .sidebar-footer { padding: 15px; font-size: 0.8em; color: var(--text-secondary); border-top: 1px solid var(--border-secondary); transition: opacity 0.2s ease; white-space: nowrap; overflow: hidden; margin-top:auto; } .sidebar-footer i { margin-right: 5px; }
        .main-content { flex-grow: 1; padding: 25px 30px; background-color: var(--bg-primary); transition: padding 0.3s ease; width: calc(100% - var(--sidebar-width)); overflow-y: auto; height: calc(100vh - var(--header-height)); } .sidebar.collapsed + .main-content { width: calc(100% - 70px); } .content-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid var(--border-primary); flex-wrap: wrap; gap: 15px; } .content-header .header-text { flex-grow: 1; } .content-header h2 { font-size: 1.8em; font-weight: 600; color: var(--text-headings); margin-bottom: 5px; display: flex; align-items: center; gap: 10px; } .content-header h2 i { color: var(--accent-primary); } .content-header p { color: var(--text-secondary); font-size: 1em; margin: 0; } .page-controls { display: flex; gap: 10px; align-items: center; flex-shrink: 0; }
        .btn { padding: 10px 18px; font-size: 0.95em; border: 1px solid transparent; border-radius: 5px; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; justify-content: center; font-weight: 500; text-decoration: none; white-space: nowrap; line-height: 1.4; } .btn i { margin-right: 8px; } .btn-primary { background-color: var(--accent-primary); color: #fff; border-color: var(--accent-primary); } .btn-primary:hover { background-color: var(--accent-primary-hover); border-color: var(--accent-primary-hover); box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15); text-decoration: none; color: #fff; } .btn-secondary { background-color: var(--accent-secondary); color: #fff; border-color: var(--accent-secondary);} .btn-secondary:hover { background-color: var(--accent-secondary-hover); border-color: var(--accent-secondary-hover); box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15); text-decoration: none; color: #fff; } .btn-light { background-color: var(--bg-tertiary); color: var(--text-primary); border: 1px solid var(--border-secondary); } .btn-light:hover { background-color: var(--border-secondary); } .btn-icon { padding: 8px 12px; }
        .btn.coming-soon { background-color: var(--accent-primary); color: #fff; border-color: var(--accent-primary); opacity: 0.6; cursor: default; pointer-events: none; } .btn.coming-soon:hover { background-color: var(--accent-primary); border-color: var(--accent-primary); box-shadow: none; } .btn.full-width { width: 100%; display: block; text-align: center; } .btn-success { background-color: var(--color-success); color: #fff; border-color: var(--color-success); } .btn-success:hover { background-color: #218838; border-color: #1e7e34; text-decoration: none; color: #fff; }
        .service-card-grid-2x2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 25px; margin-top: 25px; transition: opacity 0.3s ease, transform 0.3s ease; } .service-card-grid-2x2.hidden { opacity: 0; transform: scale(0.98); pointer-events: none; height: 0; overflow: hidden; margin-top: 0; } @keyframes cardFadeInScaleUp { from { opacity: 0; transform: translateY(-3px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } } .card.service-card { background-color: var(--bg-secondary); border-radius: 8px; border: 1px solid var(--border-primary); box-shadow: 0 1px 4px var(--shadow-primary); display: flex; flex-direction: column; transition: box-shadow 0.3s ease, transform 0.2s ease, border-color 0.2s ease; overflow: hidden; opacity: 0; animation: cardFadeInScaleUp 0.5s ease-out forwards; } .service-card-grid-2x2 .service-card:nth-child(1) { animation-delay: 0.1s; } .service-card-grid-2x2 .service-card:nth-child(2) { animation-delay: 0.15s; } .service-card-grid-2x2 .service-card:nth-child(3) { animation-delay: 0.2s; } .service-card-grid-2x2 .service-card:nth-child(4) { animation-delay: 0.25s; } .card.service-card:hover { box-shadow: 0 4px 12px var(--shadow-hover); transform: translateY(-3px); border-color: var(--card-active-border-color); } .card.service-card:active { transform: translateY(-1px); box-shadow: 0 2px 6px var(--shadow-hover); border-color: var(--card-active-border-color-hover); } .card.service-card .card-body { padding: 25px; flex-grow: 1; display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; } .card.service-card .service-icon { font-size: 3em; margin-bottom: 20px; color: var(--accent-primary); } .service-title-area { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 10px; } .card.service-card h2 { font-size: 1.4em; font-weight: 600; color: var(--text-headings); margin: 0; } .service-help-icon { color: var(--text-secondary); font-size: 1.1em; cursor: pointer; opacity: 0.7; transition: opacity 0.2s ease, color 0.2s ease; user-select: none; } .service-help-icon:hover { opacity: 1; color: var(--accent-primary); } .card.service-card p { font-size: 0.95em; color: var(--text-secondary); margin-bottom: 25px; flex-grow: 1; max-width: 90%; } .card.service-card .btn { margin-top: auto; width: 80%; }
        #dynamic-form-container { opacity: 0; transform: translateY(10px); transition: opacity 0.4s ease-out, transform 0.4s ease-out; margin-top: 0; } #dynamic-form-container.visible { opacity: 1; transform: translateY(0); margin-top: 20px; } .back-to-hub-container { margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px solid var(--border-primary); }
        .form-card { background-color: var(--bg-secondary); border-radius: 8px; border: 1px solid var(--border-primary); margin-bottom: 25px; overflow: hidden; } .form-card-header { padding: 15px 20px; background-color: var(--bg-tertiary); border-bottom: 1px solid var(--border-primary); display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background-color 0.2s ease; } .form-card-header:hover { background-color: var(--border-secondary); } .form-card-header h2 { font-size: 1.1em; font-weight: 600; margin: 0; display: flex; align-items: center; gap: 10px;} .form-card-header .toggle-icon { transition: transform 0.3s ease; } .form-card-header.collapsed .toggle-icon { transform: rotate(-90deg); }
        .form-card-body { padding: 20px; max-height: 4000px; overflow: hidden; transition: max-height 0.5s ease-in-out, padding 0.5s ease-in-out, opacity 0.3s ease-in-out 0.1s; opacity: 1; } .form-card-body.collapsed { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; transition: max-height 0.4s ease-in-out, padding 0.4s ease-in-out, opacity 0.2s ease-in-out; border-top: none; border-bottom: none; }
        #dynamic-form-container .form-group, #manage-releases-container .form-group, #manage-alerts-container .form-group { margin-bottom: 1.25rem; } 
        #dynamic-form-container label, #manage-releases-container label, #manage-alerts-container label { display: block; margin-bottom: .5rem; font-weight: 500; font-size: 0.9em; } 
        #dynamic-form-container label small, #dynamic-form-container .form-text, #manage-releases-container label small, #manage-releases-container .form-text, #manage-alerts-container label small, #manage-alerts-container .form-text { font-weight: 400; color: var(--text-secondary); display: block; margin-top: 4px; font-size: 0.85em;}
        #dynamic-form-container .form-control, #manage-releases-container .form-control, #manage-alerts-container .form-control { display: block; width: 100%; padding: .5rem .75rem; font-size: 0.95em; line-height: 1.5; color: var(--text-primary); background-color: var(--bg-secondary); background-clip: padding-box; border: 1px solid var(--border-primary); border-radius: .25rem; transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out; } 
        #dynamic-form-container .form-control:focus, #manage-releases-container .form-control:focus, #manage-alerts-container .form-control:focus { color: var(--text-primary); background-color: var(--bg-secondary); border-color: var(--accent-primary); outline: 0; box-shadow: 0 0 0 .25rem rgba(13,110,253,.25); } 
        #dynamic-form-container textarea.form-control, #manage-releases-container textarea.form-control, #manage-alerts-container textarea.form-control { min-height: 80px; }
        #dynamic-form-container select.form-control, #manage-releases-container select.form-control, #manage-alerts-container select.form-control { appearance: none; background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e"); background-repeat: no-repeat; background-position: right .75rem center; background-size: 16px 12px; }
        body.dark-mode #dynamic-form-container select.form-control, body.dark-mode #manage-releases-container select.form-control, body.dark-mode #manage-alerts-container select.form-control { background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23adb5bd' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e"); }
        #dynamic-form-container .form-check, #manage-releases-container .form-check, #manage-alerts-container .form-check { display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem; } 
        #dynamic-form-container .form-check input[type="checkbox"], #dynamic-form-container .form-check input[type="radio"], #manage-releases-container .form-check input[type="checkbox"], #manage-releases-container .form-check input[type="radio"], #manage-alerts-container .form-check input[type="checkbox"], #manage-alerts-container .form-check input[type="radio"] { width: 1em; height: 1em; margin-top: 0.25em; flex-shrink: 0;} 
        #dynamic-form-container .form-check label, #manage-releases-container .form-check label, #manage-alerts-container .form-check label { margin-bottom: 0; font-weight: 400; flex-grow: 1; } 
        #dynamic-form-container .form-check .form-text, #manage-releases-container .form-check .form-text, #manage-alerts-container .form-check .form-text { padding-left: calc(1em + 0.5rem); }
        #dynamic-form-container .form-row, #manage-releases-container .form-row, #manage-alerts-container .form-row { display: flex; flex-wrap: wrap; gap: 25px; } 
        #dynamic-form-container .form-col, #manage-releases-container .form-col, #manage-alerts-container .form-col { flex: 1; min-width: 200px; }
        #dynamic-form-container .form-card-footer, #manage-releases-container .form-card-footer, #manage-alerts-container .form-card-footer { padding: 15px 20px; background-color: var(--bg-tertiary); border-top: 1px solid var(--border-primary); display: flex; justify-content: flex-end; gap: 10px;} 
        #dynamic-form-container .form-card-footer.preview-bar, #manage-releases-container .form-card-footer.preview-bar, #manage-alerts-container .form-card-footer.preview-bar { justify-content: space-between; align-items: center;}
        #dynamic-form-container .select2-container--default .select2-selection--multiple { border: 1px solid var(--border-primary) !important; background-color: var(--bg-secondary) !important; } body.dark-mode #dynamic-form-container .select2-container--default .select2-selection--multiple { border: 1px solid var(--border-primary) !important; background-color: var(--bg-secondary) !important; } #dynamic-form-container .select2-container--default .select2-selection--multiple .select2-selection__choice { background-color: var(--accent-primary) !important; border: none !important; color: white !important; } body.dark-mode #dynamic-form-container .select2-container--default .select2-selection--multiple .select2-selection__choice { background-color: var(--accent-primary) !important; } #dynamic-form-container .select2-dropdown { background-color: var(--bg-secondary) !important; border: 1px solid var(--border-primary) !important; z-index: 1051; } body.dark-mode #dynamic-form-container .select2-dropdown { background-color: var(--bg-tertiary) !important; border: 1px solid var(--border-primary) !important; color: var(--text-primary); } body.dark-mode #dynamic-form-container .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable { background-color: var(--accent-primary) !important; }
        #dynamic-form-container .file-upload-area { border: 2px dashed var(--border-primary); padding: 20px; text-align: center; border-radius: 5px; background-color: var(--bg-primary); transition: background-color 0.2s; } #dynamic-form-container .file-upload-area.drag-over { background-color: var(--bg-tertiary); } #dynamic-form-container .file-upload-area input[type="file"] { display: none; } #dynamic-form-container .file-upload-area label { cursor: pointer; color: var(--accent-primary); font-weight: 500; } #dynamic-form-container .file-list { margin-top: 15px; font-size: 0.9em; } #dynamic-form-container .file-list-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; border: 1px solid var(--border-primary); border-radius: 4px; margin-bottom: 8px; background-color: var(--bg-secondary);} #dynamic-form-container .file-list-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 10px; } #dynamic-form-container .file-list-item button { color: var(--color-danger); background: none; border: none; cursor: pointer; font-size: 1.1em; padding: 0 5px;}
        #dynamic-form-container .stream-key-display { background-color: var(--bg-tertiary); padding: 10px 15px; border-radius: 4px; margin-top: 5px; font-family: monospace; font-size: 0.9em; color: var(--text-primary); display: flex; justify-content: space-between; align-items: center; }
        #dynamic-form-container .fieldset { border: 1px solid var(--border-primary); border-radius: 5px; padding: 20px; margin-bottom: 1.25rem; } #dynamic-form-container .fieldset legend { font-weight: 500; font-size: 0.95em; padding: 0 10px; width: auto; margin-left: 10px; } #dynamic-form-container .fieldset.alert-fieldset { border-color: var(--color-danger); background-color: rgba(var(--bs-danger-rgb), 0.1); } #dynamic-form-container .fieldset.alert-fieldset legend { color: var(--color-danger); } body.dark-mode #dynamic-form-container .fieldset.alert-fieldset { background-color: rgba(220, 53, 69, 0.2); }
        #dynamic-form-container .custom-file-input-wrapper { position: relative; overflow: hidden; display: inline-block; width: 100%; border: 1px solid var(--border-primary); border-radius: .25rem; } #dynamic-form-container .custom-file-input-wrapper input[type="file"] { position: absolute; left: 0; top: 0; opacity: 0; height: 100%; width: 100%; cursor: pointer; z-index: 5; } #dynamic-form-container .custom-file-input-label { display: block; padding: .5rem .75rem; font-size: 0.95em; line-height: 1.5; color: var(--text-secondary); background-color: var(--bg-secondary); border-radius: .25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } #dynamic-form-container .custom-file-input-button { position: absolute; right: 0; top: 0; bottom: 0; z-index: 3; display: block; height: calc(100%); padding: .5rem .75rem; line-height: 1.5; color: var(--text-primary); background-color: var(--bg-tertiary); border-left: 1px solid var(--border-primary); border-radius: 0 .25rem .25rem 0; }
        #dynamic-form-container .info-block { padding: 10px 15px; background-color: #e7f1ff; border: 1px solid #b8d6fb; border-radius: 4px; font-size: 0.9em; color: #004085; margin-bottom: 1rem;} body.dark-mode #dynamic-form-container .info-block { background-color: rgba(63, 145, 255, 0.2); border-color: rgba(63, 145, 255, 0.5); color: #cce5ff; } #dynamic-form-container .info-block i { margin-right: 8px; }

        .help-modal-backdrop, .preview-modal-backdrop { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: var(--modal-backdrop-bg); z-index: 1040; display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease; } .help-modal-backdrop.open, .preview-modal-backdrop.open { display: flex; opacity: 1; } .help-modal, .preview-modal { background-color: var(--modal-bg); color: var(--text-primary); border-radius: 8px; box-shadow: var(--modal-shadow); width: 90%; max-width: 500px; overflow: hidden; transform: scale(0.95); transition: transform 0.3s ease; border: 1px solid var(--modal-border-color); display: flex; flex-direction: column; max-height: 80vh; } .preview-modal { max-width: 650px; } .help-modal-backdrop.open .help-modal, .preview-modal-backdrop.open .preview-modal { transform: scale(1); } .help-modal-header, .preview-modal-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; border-bottom: 1px solid var(--modal-border-color); } .help-modal-header h3, .preview-modal-header h3 { margin: 0; font-size: 1.2em; font-weight: 600; color: var(--text-headings); } .help-modal-close-btn, .preview-modal-close-btn { background: none; border: none; font-size: 1.5em; line-height: 1; color: var(--text-secondary); cursor: pointer; padding: 0; opacity: 0.7; transition: opacity 0.2s ease; } .help-modal-close-btn:hover, .preview-modal-close-btn:hover { opacity: 1; color: var(--text-primary); } .help-modal-body, .preview-modal-body { padding: 20px; overflow-y: auto; } .help-modal-body { font-size: 0.95em; line-height: 1.7;} .help-modal-body p:last-child { margin-bottom: 0; } .help-modal-body ul { padding-left: 20px; margin-top: 10px; margin-bottom: 10px; } .help-modal-body li { margin-bottom: 5px; } .help-modal-body code { background-color: var(--bg-tertiary); padding: 2px 5px; border-radius: 3px; font-size: 0.9em; }
        .preview-card-placeholder { border: 1px dashed var(--border-primary); padding: 20px; background-color: var(--bg-tertiary); border-radius: 5px; text-align: center; color: var(--text-secondary); } .preview-card-placeholder img { max-width: 100%; height: auto; max-height: 150px; margin-bottom: 10px; border-radius: 4px; }

        /* New Radar Card Preview Styles - Updated Design */
        .radar-card-preview {
            border: 1px solid var(--border-primary);
            background-color: var(--bg-secondary);
            color: var(--text-primary);
            margin: 0 auto;
            max-width: 350px;
            border-radius: 8px;
            overflow: hidden;
            font-family: var(--font-family-main);
            box-shadow: 0 3px 7px var(--shadow-primary);
            transition: box-shadow 0.2s ease-out, transform 0.2s ease-out, border-color 0.2s ease-out;
            position: relative;
            display: flex;
            flex-direction: column;
        }
        
        .radar-card-preview:hover {
            box-shadow: 0 12px 28px rgba(13, 110, 253, 0.15);
            transform: translateY(-4px);
            border-color: rgba(13, 110, 253, 0.3);
        }
        
        body.dark-mode .radar-card-preview {
            border-color: var(--border-primary);
            background-color: var(--bg-secondary);
            color: var(--text-primary);
        }
        
        body.dark-mode .radar-card-preview:hover {
            box-shadow: 0 12px 28px rgba(63, 145, 255, 0.15);
            border-color: rgba(63, 145, 255, 0.3);
        }
        
        /* Card Image Area with Hover Overlay */
        .radar-card-preview .card-image-area {
            position: relative;
            width: 100%;
            height: 180px;
            background-color: var(--bg-image-placeholder);
            background-size: cover;
            background-position: center;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        
        body.dark-mode .radar-card-preview .card-image-area {
            background-color: var(--bg-image-placeholder);
        }
        
        .radar-card-preview .card-image-area img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .radar-card-preview .card-image-area .placeholder-icon {
            font-size: 3.5em;
            color: var(--text-secondary);
            opacity: 0.4;
        }
        
        /* Hover overlay with action buttons */
        .radar-card-preview .card-image-hover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--overlay-bg, rgba(0, 0, 0, 0.65));
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease-out;
            gap: 12px;
            z-index: 2;
        }
        
        .radar-card-preview:hover .card-image-hover-overlay {
            opacity: 1;
            pointer-events: auto;
        }
        
        .radar-card-preview .card-image-hover-overlay .btn {
            min-width: 160px;
            padding: 10px 20px;
            font-size: 0.95em;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 500;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        
        .radar-card-preview .card-image-hover-overlay .btn i {
            margin-right: 8px;
        }
        
        .radar-card-preview .btn-calendar {
            background-color: var(--accent-primary);
            color: white;
        }
        
        .radar-card-preview .btn-calendar:hover {
            background-color: var(--accent-primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        }
        
        .radar-card-preview .btn-reminder {
            background-color: #28a745;
            color: white;
        }
        
        .radar-card-preview .btn-reminder:hover {
            background-color: #218838;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
        }
        
        .radar-card-preview .btn-follow {
            background-color: #6c757d;
            color: white;
        }
        
        .radar-card-preview .btn-follow:hover {
            background-color: #5c636a;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
        }
        
        /* Brand band */
        .radar-card-preview .brand-band {
            padding: 8px 15px;
            font-size: 0.9em;
            font-weight: 600;
            text-align: left;
            background-color: var(--amc-card-preview-brand-band-light-bg, #212529);
            color: var(--amc-card-preview-brand-band-light-text, #f8f9fa);
            border-bottom: 1px solid var(--border-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        body.dark-mode .radar-card-preview .brand-band {
            background-color: var(--amc-card-preview-brand-band-dark-bg, #f8f9fa);
            color: var(--amc-card-preview-brand-band-dark-text, #212529);
            border-bottom-color: var(--border-secondary);
        }
        
        /* Card Content */
        .radar-card-preview .card-content-area {
            padding: 15px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        
        .radar-card-preview .card-content-area h3 {
            font-size: 1.1em;
            font-weight: 600;
            margin-bottom: 15px;
            color: var(--text-headings);
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            min-height: calc(1.45em * 3);
            cursor: pointer;
            transition: color 0.2s ease;
        }
        
        .radar-card-preview .card-content-area h3:hover {
            color: var(--accent-primary);
        }
        
        /* Bottom meta area - Match AutoMediaCenter layout exactly */
        .radar-card-preview .card-bottom-meta {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid var(--border-secondary);
        }
        
        .radar-card-preview .drop-time {
            font-size: 0.8em;
            color: var(--text-secondary);
            text-align: right;
            line-height: 1.35;
            flex-shrink: 0;
        }

        .radar-card-preview .drop-time i {
            margin-right: 3px;
            opacity: 0.7;
        }

        .radar-card-preview .drop-time .date-line {
            display: block;
        }

        .radar-card-preview .drop-time .time-line {
            display: block;
        }
        
        /* Countdown badge - More compact for inline layout */
        .radar-card-preview .countdown-badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75em;
            font-weight: 600;
            text-align: center;
            white-space: nowrap;
            flex-shrink: 0;
        }
        
        .radar-card-preview .countdown-badge.urgency-soon {
            background-color: #28a745;
            color: #fff;
        }
        
        .radar-card-preview .countdown-badge.urgency-medium {
            background-color: #ffc107;
            color: #212529;
        }
        
        .radar-card-preview .countdown-badge.urgency-far {
            background-color: #17a2b8;
            color: #fff;
        }
        
        .radar-card-preview .countdown-badge i {
            margin-right: 4px;
        }

        /* Responsive Design for Radar Cards */
        @media (max-width: 768px) {
            .radar-card-preview {
                max-width: 100%;
                margin: 0;
            }
            
            .radar-card-preview .card-image-area {
                height: 160px;
            }
            
            .radar-card-preview .card-image-hover-overlay .btn {
                min-width: 140px;
                padding: 8px 16px;
                font-size: 0.9em;
            }
            
            .radar-card-preview .card-content-area {
                padding: 12px;
            }
            
            .radar-card-preview .card-content-area h3 {
                font-size: 1em;
                margin-bottom: 12px;
            }
            
            .radar-card-preview .card-bottom-meta {
                flex-direction: column;
                gap: 8px;
                align-items: flex-start;
            }
            
            .radar-card-preview .drop-time {
                font-size: 0.75em;
            }
            
            .radar-card-preview .countdown-badge {
                font-size: 0.7em;
                padding: 3px 6px;
                align-self: flex-end;
            }
        }

        @media (max-width: 576px) {
            .radar-card-preview .card-image-area {
                height: 140px;
            }
            
            .radar-card-preview .card-image-hover-overlay {
                gap: 8px;
            }
            
            .radar-card-preview .card-image-hover-overlay .btn {
                min-width: 120px;
                padding: 6px 12px;
                font-size: 0.85em;
            }
            
            .radar-card-preview .card-content-area {
                padding: 10px;
            }
            
            .radar-card-preview .brand-band {
                padding: 6px 10px;
                font-size: 0.8em;
            }
        }

        @media (max-width: 768px) { .service-card-grid-2x2 { grid-template-columns: 1fr; } .main-content { width: 100%; padding: 20px;} .sidebar.collapsed + .main-content { width: 100%; } .card.service-card .btn { width: 90%; } .content-header { flex-direction: column; align-items: flex-start; } .page-controls { width: 100%; justify-content: flex-end; } .form-col { min-width: 100% !important; } }
         @media (max-width: 576px) { .content-header h2 { font-size: 1.5em; } .card.service-card .card-body { padding: 20px; } .card.service-card h2 { font-size: 1.2em; } .card.service-card p { font-size: 0.9em; } .help-modal, .preview-modal { width: 95%; } }

        .app-footer { background-color: var(--header-bg); color: var(--header-link); padding: 15px 30px; text-align: center; font-size: 0.9em; border-top: 1px solid var(--border-primary); height: var(--footer-height); flex-shrink: 0; margin-top: auto; }

        #login-container {
             background-color: var(--login-overlay-bg, rgba(0,0,0,0.7));
             display: flex; align-items: center; justify-content: center;
             position: fixed; top: 0; left: 0; width: 100%; height: 100%;
             z-index: 2000; transition: opacity 0.3s ease;
        }
        #login-form-card {
             background-color: var(--bg-secondary); color: var(--text-primary);
             border: 1px solid var(--border-secondary); padding: 30px 40px;
             border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.3);
             width: 100%; max-width: 400px;
        }
        #login-form-card h2 { color: var(--text-headings); text-align: center; margin-top: 0; margin-bottom: 25px; }
        #login-form-card label { color: var(--text-primary); font-size: 0.9em; font-weight: 500; margin-bottom: 5px; display: block; }
        #login-form-card .form-group { margin-bottom: 15px; }
        #login-form-card .form-control {
            display: block; width: 100%; padding: .5rem .75rem; font-size: 0.95em; line-height: 1.5;
            color: var(--text-primary); background-color: var(--bg-secondary); background-clip: padding-box;
            border: 1px solid var(--border-primary); border-radius: .25rem;
            transition: border-color .15s ease-in-out,box-shadow .15s ease-in-out;
        }
        #login-form-card .form-control:focus {
            color: var(--text-primary); background-color: var(--bg-secondary); border-color: var(--accent-primary);
            outline: 0; box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
        }
        #login-form-card button[type="submit"] { width: 100%; margin-top: 10px; }
        #login-error-message { color: var(--color-danger); text-align: center; margin-top: 15px; font-size: 0.9em; display: none; }


        /* Added: AMC Card Preview Styles */
        .amc-card-preview-wrapper {
            border: 1px solid var(--border-primary);
            padding: 15px;
            border-radius: 5px;
            margin-top: 15px;
            background-color: var(--bg-primary);
        }
        .amc-card-preview {
            width: 270px; /* Match approx card width */
            background-color: var(--bg-secondary);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 3px 7px var(--shadow-primary);
            display: flex;
            flex-direction: column;
            border: 1px solid var(--border-secondary);
            font-family: var(--font-family-main);
            color: var(--text-primary);
            margin: 0 auto; /* Center the preview card */
        }
        .amc-card-preview .card-image-field {
            height: 140px; /* Slightly smaller preview image height */
            background-color: var(--bg-image-placeholder);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .amc-card-preview .card-image-field img {
            width: 100%;
            height: 100%;
            object-fit: cover; 
        }
         .amc-card-preview .card-image-field .placeholder-icon {
            font-size: 2.5em;
            color: var(--text-secondary);
        }
        .amc-card-preview .brand-band {
            padding: 6px 12px;
            font-size: 0.85em;
            font-weight: 600;
            background-color: var(--amc-card-preview-brand-band-light-bg);
            color: var(--amc-card-preview-brand-band-light-text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            border-bottom: 1px solid var(--border-primary);
        }
        body.dark-mode .amc-card-preview .brand-band {
            background-color: var(--amc-card-preview-brand-band-light-bg);
            color: var(--amc-card-preview-brand-band-light-text);
            border-bottom-color: var(--border-secondary);
        }
        .amc-card-preview .card-content-body {
            padding: 12px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .amc-card-preview .card-content-body h3 {
            font-size: 1em;
            font-weight: 600;
            color: var(--text-headings);
            line-height: 1.4;
            margin: 0 0 8px 0;
            display: -webkit-box; -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden; text-overflow: ellipsis;
            min-height: calc(1.4em * 3);
        }
        .amc-card-preview .card-bottom-meta {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: auto;
            padding-top: 8px;
            border-top: 1px solid var(--border-secondary);
        }
        .amc-card-preview .card-assets {
            display: flex;
            gap: 8px;
        }
        .amc-card-preview .asset-icon {
            font-size: 0.85em;
            color: var(--amc-card-preview-icon-unavailable);
        }
        .amc-card-preview .asset-icon.available {
            color: var(--amc-card-preview-icon-available);
        }
        .amc-card-preview .asset-icon i { margin-right: 3px; font-size: 1em;}
        .amc-card-preview .asset-icon .asset-count-badge { font-size: 0.8em; }
        .amc-card-preview .release-date-time-footer {
            font-size: 0.7em;
            color: var(--text-secondary);
            text-align: right;
            line-height: 1.3;
        }
         .amc-card-preview .release-date-time-footer .date-part,
         .amc-card-preview .release-date-time-footer .time-part { display: block; }
         .amc-card-preview .release-date-time-footer i { margin-right: 2px; }

        /* Styles for Manage Releases Table */
        #manage-releases-container, #manage-alerts-container {
            background-color: var(--bg-secondary);
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px var(--shadow-primary);
        }
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1rem;
            background-color: var(--table-bg);
            color: var(--text-primary);
            font-size: 0.9em;
        }
        .data-table th, .data-table td {
            padding: 10px 12px;
            border: 1px solid var(--table-border-color);
            text-align: left;
            vertical-align: middle;
        }
        .data-table thead th {
            background-color: var(--table-header-bg);
            font-weight: 600;
            border-bottom-width: 2px;
        }
        .data-table tbody tr:hover {
            background-color: var(--table-hover-bg);
        }
        .data-table tbody tr:nth-of-type(even) {
             background-color: var(--table-stripe-bg);
        }
        body.dark-mode .data-table tbody tr:nth-of-type(even) {
             background-color: var(--table-stripe-bg);
        }
        .data-table .status-draft, .data-table .status-Draft {
            background-color: var(--color-warning);
            color: #333;
            padding: 3px 7px;
            border-radius: 4px;
            font-size: 0.85em;
            font-weight: 500;
        }
        .data-table .status-published, .data-table .status-Active {
            background-color: var(--color-success);
            color: #fff;
            padding: 3px 7px;
            border-radius: 4px;
            font-size: 0.85em;
            font-weight: 500;
        }
        .data-table .status-Archived {
             background-color: var(--accent-secondary); color: #fff;
             padding: 3px 7px; border-radius: 4px; font-size: 0.85em; font-weight: 500;
        }
        .data-table .action-buttons .btn {
            margin-right: 5px;
            padding: 5px 10px;
            font-size: 0.85em;
        }
        .data-table .action-buttons .btn-edit-radar-alert {
            background-color: var(--accent-primary);
            color: #fff;
        }

        .pagination-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 20px;
        }
        .pagination-controls .btn {
            margin: 0 5px;
        }
        .pagination-controls .page-info {
            margin: 0 10px;
            font-size: 0.9em;
            color: var(--text-secondary);
        }
        .loading-placeholder, .no-data-placeholder {
            text-align: center;
            padding: 20px;
            color: var(--text-secondary);
            font-style: italic;
        }
        /* --- MODIFICATION START --- CSS FOR TEASER PREVIEW IN FORM */
        #dynamic-form-container .form-text em,
        #manage-releases-container .form-text em {
            color: var(--text-secondary);
        }
        #dynamic-form-container .form-text a,
        #manage-releases-container .form-text a {
            font-weight: 500;
        }
        #dynamic-form-container #currentCardTeaserImageInfo img,
        #dynamic-form-container #uploadedRadarTeaserImageList img {
            max-width: 100px;
            max-height: 60px;
            border-radius: 3px;
            border: 1px solid var(--border-secondary);
            margin-right: 10px;
            vertical-align: middle;
        }
        /* --- MODIFICATION END --- */

    </style>
</head>
<body>
    <!-- ===== LOGIN FORM CONTAINER ===== -->
    <div id="login-container" style="display: none;">
        <div id="login-form-card">
            <h2>Client Hub Login</h2>
            <form id="login-form">
                <div class="form-group">
                    <label for="login-email">Email Address</label>
