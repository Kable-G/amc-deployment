{
  "name": "currency-converter-pro",
  "version": "1.0.0",
  "description": "Industry-leading currency converter with real-time exchange rates, PWA capabilities, and comprehensive testing",
  "main": "currencyconverter.html",
  "scripts": {
    "dev": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "build:analyze": "webpack --mode production --analyze",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.{js,css,html}",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "lighthouse": "lighthouse http://localhost:8080 --output html --output-path ./reports/lighthouse.html",
    "accessibility": "axe-core http://localhost:8080",
    "performance": "node scripts/performance-test.js",
    "security": "node scripts/security-scan.js",
    "deploy": "npm run build && npm run test && npm run lighthouse",
    "start": "serve -s dist -l 8080",
    "clean": "rimraf dist coverage reports",
    "precommit": "lint-staged",
    "prepare": "husky install"
  },
  "keywords": [
    "currency",
    "converter",
    "exchange-rates",
    "pwa",
    "offline",
    "accessibility",
    "performance",
    "finance",
    "tools"
  ],
  "author": "AutoMediaCenter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/automediacentre/currency-converter-pro.git"
  },
  "bugs": {
    "url": "https://github.com/automediacentre/currency-converter-pro/issues"
  },
  "homepage": "https://automediacentre.com/tools/currency-converter",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "axe-core": "^4.8.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "css-minimizer-webpack-plugin": "^5.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-accessibility": "^5.0.0",
    "eslint-plugin-security": "^1.7.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^11.0.0",
    "lint-staged": "^15.0.0",
    "mini-css-extract-plugin": "^2.7.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "serve": "^14.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "webpack-pwa-manifest": "^4.3.0",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "dependencies": {
    "core-js": "^3.33.0",
    "regenerator-runtime": "^0.14.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "pwa": {
    "name": "Currency Converter Pro",
    "short_name": "Currency Pro",
    "description": "Professional currency converter with offline support",
    "theme_color": "#0d6efd",
    "background_color": "#f8f9fa",
    "display": "standalone",
    "orientation": "portrait",
    "start_url": "/",
    "scope": "/",
    "icons": [
      {
        "src": "assets/icons/icon-192x192.png",
        "sizes": "192x192",
        "type": "image/png"
      },
      {
        "src": "assets/icons/icon-512x512.png",
        "sizes": "512x512",
        "type": "image/png"
      }
    ]
  },
  "performance": {
    "budgets": [
      {
        "type": "initial",
        "maximumWarning": "500kb",
        "maximumError": "1mb"
      },
      {
        "type": "anyComponentStyle",
        "maximumWarning": "50kb",
        "maximumError": "100kb"
      }
    ]
  },
  "security": {
    "csp": {
      "default-src": "'self'",
      "script-src": "'self' 'unsafe-inline'",
      "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com",
      "img-src": "'self' https://flagcdn.com data:",
      "connect-src": "'self' https://api.frankfurter.app",
      "font-src": "'self' https://fonts.gstatic.com",
      "object-src": "'none'",
      "base-uri": "'self'",
      "form-action": "'self'"
    }
  }
}