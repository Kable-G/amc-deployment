/**
 * Simple Welcome Modal - Enterprise Grade
 * Overlays AutoMediaCenter with grey filter
 * Clean, fast, professional design
 */

/* Hidden class for initial state */
.hidden {
    display: none !important;
}

/* Page Content Filter (Grey overlay except header) */
.page-content-filter {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    z-index: 1500;
    pointer-events: none; /* Allow clicks to pass through to close modal */
}

/* Modal Backdrop */
.simple-welcome-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: all; /* Modal should capture clicks */
}

.simple-welcome-backdrop.show {
    opacity: 1;
    visibility: visible;
}

/* Modal Container */
.simple-welcome-modal {
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.15);
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    transform: scale(0.9) translateY(30px);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
}

.simple-welcome-backdrop.show .simple-welcome-modal {
    transform: scale(1) translateY(0);
}

/* Modal Header */
.welcome-header {
    text-align: center;
    padding: 32px 24px 24px;
    background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%);
    color: white;
    position: relative;
}

.welcome-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="10" cy="10" r="1" fill="rgba(255,255,255,0.1)"/></pattern></defs><rect width="100" height="100" fill="url(%23dots)"/></svg>');
    opacity: 0.6;
}

.welcome-icon {
    position: relative;
    z-index: 1;
    margin-bottom: 16px;
}

.welcome-icon i {
    font-size: 40px;
    color: #4caf50;
    background: rgba(255, 255, 255, 0.15);
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 255, 255, 0.2);
}

.welcome-header h2 {
    position: relative;
    z-index: 1;
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.3px;
}

.user-email {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 14px;
    opacity: 0.9;
    font-weight: 400;
}

/* Modal Content */
.welcome-content {
    padding: 24px;
}

.update-info {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    position: relative;
}

.update-info::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: #1a73e8;
    border-radius: 2px 0 0 2px;
}

.update-info i {
    color: #1a73e8;
    font-size: 20px;
    flex-shrink: 0;
}

.update-info span {
    font-size: 15px;
    color: #374151;
    line-height: 1.4;
}

.quick-stats {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 16px;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: #6b7280;
}

.stat-item i {
    color: #9ca3af;
    font-size: 16px;
    width: 20px;
    text-align: center;
    flex-shrink: 0;
}

/* Modal Footer */
.welcome-footer {
    padding: 0 32px 32px;
    text-align: center;
}

.btn-continue {
    background: #1a73e8;
    color: white;
    border: none;
    border-radius: 24px;
    padding: 14px 32px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(26, 115, 232, 0.25);
    min-width: 160px;
    justify-content: center;
    font-family: 'Google Sans', sans-serif;
}

.btn-continue:hover {
    background: #1557b0;
    box-shadow: 0 4px 12px rgba(26, 115, 232, 0.35);
    transform: translateY(-1px);
}

.btn-continue:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(26, 115, 232, 0.25);
}

/* Role-based Color Indicator */
.role-indicator {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #1a73e8; /* Default: Media User - Blue */
}

/* Role-based colors */
.role-indicator.media-user {
    background: #1a73e8; /* Blue */
}

.role-indicator.client-user {
    background: #34a853; /* Green */
}

.role-indicator.client-admin {
    background: #ff9800; /* Orange */
}

.role-indicator.platform-admin {
    background: #ea4335; /* Red */
}

/* Legacy support for old btn-explore class */
.btn-explore {
    background: #1a73e8;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 14px 32px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 2px 4px rgba(26, 115, 232, 0.2);
    min-width: 140px;
    justify-content: center;
}

.btn-explore:hover {
    background: #1557b0;
    box-shadow: 0 4px 12px rgba(26, 115, 232, 0.3);
    transform: translateY(-1px);
}

.btn-explore:active {
    transform: translateY(0);
    box-shadow: 0 2px 4px rgba(26, 115, 232, 0.2);
}

/* Responsive Design */
@media (max-width: 480px) {
    .simple-welcome-backdrop {
        padding: 16px;
    }
    
    .simple-welcome-modal {
        max-width: 100%;
        border-radius: 12px;
    }
    
    .welcome-header {
        padding: 28px 20px 20px;
    }
    
    .welcome-header h2 {
        font-size: 22px;
    }
    
    .welcome-content {
        padding: 20px;
    }
    
    .update-info {
        padding: 16px;
        flex-direction: column;
        text-align: center;
        gap: 12px;
    }
    
    .welcome-footer {
        padding: 16px 20px 20px;
    }
    
    .btn-explore {
        width: 100%;
        padding: 16px 24px;
    }
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
    .simple-welcome-modal {
        background: #1f2937;
        color: #f9fafb;
    }
    
    .update-info {
        background: #374151;
        border-color: #4b5563;
    }
    
    .update-info span {
        color: #e5e7eb;
    }
    
    .quick-stats {
        background: #374151;
        border-color: #4b5563;
    }
    
    .stat-item {
        color: #d1d5db;
    }
    
    .stat-item i {
        color: #9ca3af;
    }
}

/* Smooth animations */
@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.simple-welcome-backdrop.show .update-info {
    animation: slideInUp 0.4s ease 0.1s both;
}

.simple-welcome-backdrop.show .quick-stats {
    animation: slideInUp 0.4s ease 0.2s both;
}

.simple-welcome-backdrop.show .welcome-footer {
    animation: slideInUp 0.4s ease 0.3s both;
}

/* Ensure header stays unfiltered */
body.welcome-modal-active header,
body.welcome-modal-active .header,
body.welcome-modal-active nav {
    position: relative;
    z-index: 1600; /* Above the filter but below the modal */
}