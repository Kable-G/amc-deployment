<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - AutoMediaCenter</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #f8f9fa;
            --bg-secondary: #ffffff;
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --accent-primary: #0d6efd;
            --accent-success: #198754;
            --accent-warning: #ffc107;
            --accent-danger: #dc3545;
            --border-primary: #dee2e6;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .welcome-container {
            background: var(--bg-secondary);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            padding: 3rem;
            text-align: center;
            max-width: 600px;
            width: 100%;
            position: relative;
            overflow: hidden;
        }

        .welcome-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-primary), var(--accent-success));
        }

        .welcome-icon {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-success));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .welcome-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 1rem;
        }

        .welcome-subtitle {
            font-size: 1.2rem;
            color: var(--text-secondary);
            margin-bottom: 2rem;
        }

        .user-info-card {
            background: var(--bg-primary);
            border-radius: 12px;
            padding: 2rem;
            margin: 2rem 0;
            border-left: 4px solid var(--accent-primary);
        }

        .user-email {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        .user-role {
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            margin: 0.5rem 0;
        }

        .role-media_user {
            background: linear-gradient(135deg, #e3f2fd, #bbdefb);
            color: #1976d2;
        }

        .role-client_user {
            background: linear-gradient(135deg, #f3e5f5, #e1bee7);
            color: #7b1fa2;
        }

        .role-client_admin {
            background: linear-gradient(135deg, #fff3e0, #ffcc02);
            color: #f57c00;
        }

        .role-platform_admin {
            background: linear-gradient(135deg, #ffebee, #ffcdd2);
            color: #d32f2f;
        }

        .permissions-list {
            text-align: left;
            margin: 1.5rem 0;
        }

        .permissions-list h4 {
            color: var(--text-primary);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .permission-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0;
            color: var(--text-secondary);
        }

        .permission-item i {
            color: var(--accent-success);
            width: 20px;
        }

        .client-info {
            background: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            border-radius: 8px;
            padding: 1rem;
            margin: 1rem 0;
        }

        .client-name {
            font-weight: 600;
            color: var(--accent-primary);
            margin-bottom: 0.5rem;
        }

        .actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            min-width: 140px;
            justify-content: center;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-primary), #0b5ed7);
            color: white;
            box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
        }

        .btn-success {
            background: linear-gradient(135deg, var(--accent-success), #146c43);
            color: white;
            box-shadow: 0 4px 15px rgba(25, 135, 84, 0.3);
        }

        .btn-warning {
            background: linear-gradient(135deg, var(--accent-warning), #e0a800);
            color: var(--text-primary);
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        }

        .loading {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            color: var(--text-secondary);
        }

        .spinner {
            border: 3px solid var(--border-primary);
            border-top: 3px solid var(--accent-primary);
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            .welcome-container {
                padding: 2rem;
                margin: 1rem;
            }
            
            .welcome-title {
                font-size: 2rem;
            }
            
            .actions {
                flex-direction: column;
            }
            
            .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="welcome-container">
        <div id="loadingState" class="loading">
            <div class="spinner"></div>
            <span>Loading your profile...</span>
        </div>

        <div id="welcomeContent" style="display: none;">
            <div class="welcome-icon">
                <i class="fas fa-user-shield"></i>
            </div>
            
            <h1 class="welcome-title">Welcome to AutoMediaCenter!</h1>
            <p class="welcome-subtitle">Your authentication was successful</p>

            <div class="user-info-card">
                <div class="user-email" id="userEmail">Loading...</div>
                <div class="user-role" id="userRole">Loading...</div>
                <div id="userDescription">Loading...</div>
            </div>

            <div id="clientInfo" style="display: none;">
                <h4><i class="fas fa-building"></i> Your Client Access</h4>
                <div id="clientsList"></div>
            </div>

            <div class="permissions-list">
                <h4><i class="fas fa-key"></i> What you can do:</h4>
                <div id="permissionsList">Loading...</div>
            </div>

            <div class="actions">
                <a href="#" class="btn btn-primary" id="primaryAction">
                    <i class="fas fa-home"></i> Go to Dashboard
                </a>
                <a href="#" class="btn btn-success" id="secondaryAction" style="display: none;">
                    <i class="fas fa-upload"></i> Upload Content
                </a>
                <a href="#" class="btn btn-warning" id="adminAction" style="display: none;">
                    <i class="fas fa-cog"></i> Admin Panel
                </a>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = 'http://localhost:5000/api/v1';
        let currentUser = null;

        document.addEventListener('DOMContentLoaded', async () => {
            await loadUserProfile();
        });

        async function loadUserProfile() {
            const token = localStorage.getItem('token') || localStorage.getItem('authToken');
            
            if (!token) {
                window.location.href = '/login-test.html';
                return;
            }

            try {
                const response = await fetch(`${API_BASE}/auth/validate-permissions`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (!response.ok) {
                    throw new Error('Authentication failed');
                }

                const data = await response.json();
                currentUser = data.user;
                
                displayUserProfile(currentUser);
                
            } catch (error) {
                console.error('Failed to load user profile:', error);
                localStorage.removeItem('token');
                localStorage.removeItem('authToken');
                window.location.href = '/login-test.html';
            }
        }

        function displayUserProfile(user) {
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('welcomeContent').style.display = 'block';

            // Set user info
            document.getElementById('userEmail').textContent = user.email;
            
            const roleElement = document.getElementById('userRole');
            roleElement.textContent = formatRole(user.role);
            roleElement.className = `user-role role-${user.role}`;

            // Set role description
            const descriptions = {
                'media_user': 'You can view and download media releases from all automotive brands.',
                'client_user': 'You can upload and manage media releases for your company.',
                'client_admin': 'You can upload, manage releases, and oversee your company\'s media presence.',
                'platform_admin': 'You have full system control and can manage all users and companies.'
            };
            
            document.getElementById('userDescription').textContent = descriptions[user.role] || 'Welcome to the platform!';

            // Show client info for client users
            if (user.clientPermissions && user.clientPermissions.length > 0) {
                displayClientInfo(user.clientPermissions);
            } else if (user.clientId) {
                displayPrimaryClient(user.clientId);
            }

            // Set permissions
            displayPermissions(user.role, user.clientPermissions);

            // Set action buttons
            setActionButtons(user.role);
        }

        function displayClientInfo(clientPermissions) {
            const clientInfo = document.getElementById('clientInfo');
            const clientsList = document.getElementById('clientsList');
            
            clientsList.innerHTML = '';
            
            clientPermissions.forEach(permission => {
                const clientDiv = document.createElement('div');
                clientDiv.className = 'client-info';
                clientDiv.innerHTML = `
                    <div class="client-name">${permission.clientName}</div>
                    <div>Role: <span class="user-role role-${permission.role}">${formatRole(permission.role)}</span></div>
                    <div>Permissions: ${permission.permissions.join(', ')}</div>
                `;
                clientsList.appendChild(clientDiv);
            });
            
            clientInfo.style.display = 'block';
        }

        function displayPrimaryClient(clientId) {
            if (clientId && clientId.clientName) {
                const clientInfo = document.getElementById('clientInfo');
                const clientsList = document.getElementById('clientsList');
                
                clientsList.innerHTML = `
                    <div class="client-info">
                        <div class="client-name">${clientId.clientName}</div>
                        <div>Primary Client Assignment</div>
                    </div>
                `;
                
                clientInfo.style.display = 'block';
            }
        }

        function displayPermissions(role, clientPermissions) {
            const permissionsList = document.getElementById('permissionsList');
            const permissions = getPermissionsForRole(role, clientPermissions);
            
            permissionsList.innerHTML = permissions.map(permission => `
                <div class="permission-item">
                    <i class="fas fa-check"></i>
                    <span>${permission}</span>
                </div>
            `).join('');
        }

        function getPermissionsForRole(role, clientPermissions) {
            const basePermissions = {
                'media_user': [
                    'View and download media releases',
                    'Access AutoMediaRadar alerts',
                    'Browse automotive industry content',
                    'Use search and filtering tools'
                ],
                'client_user': [
                    'Upload media assets and releases',
                    'View and download content',
                    'Manage your company\'s releases',
                    'Access upload dashboard'
                ],
                'client_admin': [
                    'Upload and manage media releases',
                    'View analytics and insights',
                    'Manage team members',
                    'Full company content control',
                    'Access admin features'
                ],
                'platform_admin': [
                    'Full system administration',
                    'Manage all users and companies',
                    'Access all platform features',
                    'System configuration and monitoring',
                    'Complete platform oversight'
                ]
            };

            let permissions = basePermissions[role] || [];

            // Add specific client permissions if available
            if (clientPermissions && clientPermissions.length > 0) {
                const additionalPerms = clientPermissions.flatMap(cp => 
                    cp.permissions.map(p => `${p.replace('_', ' ')} for ${cp.clientName}`)
                );
                permissions = [...permissions, ...additionalPerms];
            }

            return permissions;
        }

        function setActionButtons(role) {
            const primaryAction = document.getElementById('primaryAction');
            const secondaryAction = document.getElementById('secondaryAction');
            const adminAction = document.getElementById('adminAction');

            switch (role) {
                case 'media_user':
                    primaryAction.href = '/automediacenter.html';
                    primaryAction.innerHTML = '<i class="fas fa-home"></i> Browse Content';
                    break;

                case 'client_user':
                    primaryAction.href = '/automediacenter.html';
                    primaryAction.innerHTML = '<i class="fas fa-home"></i> Go to Dashboard';
                    secondaryAction.href = '/AssetDBmenu1.6.html';
                    secondaryAction.innerHTML = '<i class="fas fa-upload"></i> Upload Content';
                    secondaryAction.style.display = 'inline-flex';
                    break;

                case 'client_admin':
                    primaryAction.href = '/automediacenter.html';
                    primaryAction.innerHTML = '<i class="fas fa-home"></i> Go to Dashboard';
                    secondaryAction.href = '/AssetDBmenu1.6.html';
                    secondaryAction.innerHTML = '<i class="fas fa-upload"></i> Upload Content';
                    secondaryAction.style.display = 'inline-flex';
                    break;

                case 'platform_admin':
                    primaryAction.href = '/admin-dashboard.html';
                    primaryAction.innerHTML = '<i class="fas fa-shield-alt"></i> Admin Dashboard';
                    secondaryAction.href = '/automediacenter.html';
                    secondaryAction.innerHTML = '<i class="fas fa-home"></i> Main Platform';
                    secondaryAction.style.display = 'inline-flex';
                    adminAction.href = '/AssetDBmenu1.6.html';
                    adminAction.innerHTML = '<i class="fas fa-cog"></i> Upload System';
                    adminAction.style.display = 'inline-flex';
                    break;
            }
        }

        function formatRole(role) {
            const roleNames = {
                'media_user': 'Media User',
                'client_user': 'Client User',
                'client_admin': 'Client Admin',
                'platform_admin': 'Platform Admin'
            };
            return roleNames[role] || role;
        }

        // Auto-redirect after 10 seconds if user doesn't click anything
        setTimeout(() => {
            const primaryAction = document.getElementById('primaryAction');
            if (primaryAction && primaryAction.href) {
                window.location.href = primaryAction.href;
            }
        }, 10000);
    </script>
</body>
</html>